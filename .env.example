# ══════════════════════════════════════════════════════════════
#  AgentHive — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials.
# See CREDENTIALS_GUIDE.md for step-by-step instructions on
# obtaining every key listed here.

# ── LLM (Gemini via OpenRouter) ──────────────────────────────
# Your OpenRouter API key (or a direct Google AI Studio Gemini API key)
GEMINI_API_KEY=
# Model identifier (OpenRouter format: google/gemini-2.5-flash)
LLM_MODEL=google/gemini-2.5-flash
# API base URL (OpenRouter or direct Gemini endpoint)
GEMINI_BASE_URL=https://openrouter.ai/api/v1

# ── WhatsApp Gateway ─────────────────────────────────────────
# Provider: "meta" (production) or "twilio" (sandbox — faster for demo)
WHATSAPP_PROVIDER=twilio

# Meta Cloud API (used when WHATSAPP_PROVIDER=meta)
WHATSAPP_VERIFY_TOKEN=agenthive-verify
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio WhatsApp Sandbox (used when WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Voice ────────────────────────────────────────────────────
# Dashboard: uses browser Web Speech API — no key needed.
# WhatsApp voice notes: uses Gemini native audio input — reuses GEMINI_API_KEY.
# WhatsApp voice replies (TTS): stretch item — would need GOOGLE_CLOUD_TTS_API_KEY.

# ── Google Calendar (OAuth 2.0 per-user) ─────────────────────
# OAuth Client ID and Secret from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback

# ── Supabase (Auth + Database) ───────────────────────────────
# Project URL from Supabase → Settings → API
SUPABASE_URL=
# Public anon key (safe for frontend)
SUPABASE_ANON_KEY=
# Service role key (backend only — NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (Supabase → Settings → Database → Connection string)
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Razorpay (Payments — optional) ──────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
